# Copia a .env y rellena. .env está en .gitignore: los valores reales NUNCA se commitean.
SUPABASE_PROJECT_REF=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Token personal (sbp_...) de https://supabase.com/dashboard/account/tokens — para MCP y CLI
SUPABASE_ACCESS_TOKEN=
# Contraseña de la base elegida al crear el proyecto — para supabase db push
SUPABASE_DB_PASSWORD=

# --- API / worker (S0.6a) ---
# Local: hs256 con el secreto legacy del stack de supabase start.
# Producción: jwks (ES256) — el proyecto remoto firma asimétrico; hs256 se RECHAZA con NODE_ENV=production.
LADINO_AUTH_MODE=hs256
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
SUPABASE_AUTH_ISSUER=http://127.0.0.1:54321/auth/v1
SUPABASE_JWKS_URL=
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres
PORT=3000
RATE_LIMIT_PER_MINUTE=300
REQUEST_TIMEOUT_MS=30000
