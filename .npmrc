# Solo pnpm. Un lockfile. (ADR-0001)
engine-strict=true

# node-linker aislado: es el default, queda explícito porque es una decisión (ADR-0022).
# `hoisted` está DESCARTADO: es global al workspace y anularía la detección de dependencias
# no declaradas en los 16 paquetes, para cubrir un fallo de Metro que hoy no tenemos.
node-linker=isolated

prefer-workspace-packages=true
save-exact=true
strict-peer-dependencies=false
