# Ladino en el VPS — variables del compose (NO secretos). En el VPS:
#   cp compose.env.example .env    (docker compose lee `.env` automáticamente)
# Los SECRETOS van aparte, en api.env y worker.env (plantillas en
# infra/compose/*.env.example).

# Los dominios de Ladino (registro A en el DNS → 72.60.113.85, ANTES de todo).
LADINO_API_HOST=api.TU-DOMINIO.com
LADINO_WEB_HOST=app.TU-DOMINIO.com

# Lo que Vite hornea en el bundle de la web. Ninguna es secreta.
VITE_SUPABASE_URL=https://udacvwnhwpsdzbouhqhl.supabase.co
# La publishable/anon key del proyecto: Supabase → Settings → API keys.
VITE_SUPABASE_PUBLISHABLE_KEY=REEMPLAZAR
VITE_API_URL=https://api.TU-DOMINIO.com

# El Traefik del VPS, tal como existe (defaults correctos para este VPS):
TRAEFIK_NETWORK=n8n_default
TRAEFIK_CERT_RESOLVER=mytlschallenge
TRAEFIK_ENTRYPOINT=websecure
