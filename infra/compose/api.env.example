# /etc/ladino/api.env — secretos del servicio, en el HOST, chmod 600, fuera de git.

# Pooler de Supabase en MODO TRANSACCIÓN (puerto 6543). No el 5432 directo:
# la API usa `set local` y `prepare: false` contando con este modo (S0.5).
DATABASE_URL=postgresql://postgres.igpfrwdgmicgyirwdbgs:REEMPLAZAR@aws-0-REGION.pooler.supabase.com:6543/postgres

# Verificación de JWT en modo jwks (ES256): solo la clave PÚBLICA del proyecto.
LADINO_AUTH_MODE=jwks
SUPABASE_JWKS_URL=https://igpfrwdgmicgyirwdbgs.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_AUTH_ISSUER=https://igpfrwdgmicgyirwdbgs.supabase.co/auth/v1

# Opcionales (valores por defecto): peticiones/min por usuario y plazo por petición.
# REQUEST_TIMEOUT_MS debe quedar MUY por debajo de los 15 min del reaper de idempotencia.
RATE_LIMIT_PER_MINUTE=300
REQUEST_TIMEOUT_MS=30000
