# Variables del compose (NO secretos): copia a infra/compose/.env en el VPS y
# rellena. Los secretos de cada servicio van en /etc/ladino/api.env y
# /etc/ladino/worker.env (plantillas: api.env.example, worker.env.example).

# Imágenes POR DIGEST, de releases/manifest.json. Nunca un tag.
LADINO_API_IMAGE=ghcr.io/emanuelgcq/ladino-api@sha256:REEMPLAZAR
LADINO_WORKER_IMAGE=ghcr.io/emanuelgcq/ladino-worker@sha256:REEMPLAZAR

# Traefik EXISTENTE: se consulta en el VPS, no se inventa.
#   red:         docker network ls  → la que usa el Traefik ya desplegado
#   resolver:    el certresolver definido en su configuración estática (no se toca)
#   entrypoint:  normalmente websecure
TRAEFIK_NETWORK=REEMPLAZAR
TRAEFIK_CERT_RESOLVER=REEMPLAZAR
TRAEFIK_ENTRYPOINT=websecure

LADINO_API_HOST=api.ladino.REEMPLAZAR
