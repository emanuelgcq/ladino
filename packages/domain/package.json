{
  "name": "@ladino/domain",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Casos de uso administrativos transaccionales",
  "exports": {
    ".": {
      "ladino-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "@ladino/core": "workspace:*",
    "@ladino/db": "workspace:*",
    "@ladino/inventory": "workspace:*",
    "@ladino/money": "workspace:*",
    "@ladino/schemas": "workspace:*",
    "@ladino/pricing": "workspace:*",
    "@ladino/sales": "workspace:*"
  }
}
