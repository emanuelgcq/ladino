{
  "name": "@ladino/money",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Decimal, redondeo nombrado, FX. Puro.",
  "exports": {
    ".": {
      "ladino-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./format": {
      "ladino-source": "./src/format.ts",
      "types": "./dist/format.d.ts",
      "default": "./dist/format.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint src test",
    "test": "vitest run",
    "api-surface": "node ../../scripts/assert-no-number-in-dts.mjs dist"
  },
  "dependencies": {
    "@ladino/core": "workspace:*",
    "decimal.js": "^10.6.0"
  },
  "devDependencies": {
    "fast-check": "^4.3.0"
  }
}
